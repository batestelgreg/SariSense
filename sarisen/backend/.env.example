# ------------------------------------------------------------------
# SariSense backend configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.
# ------------------------------------------------------------------

# Supabase -> Project Settings -> Database -> Connection string (URI)
# Use the POOLER host (port 6543) for Render, or the direct host (port 5432) locally.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-string

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-4-hydrogen

# Comma-separated list of allowed frontend origins.
# Local dev example:  http://127.0.0.1:5500,http://localhost:5500
# Production example: https://yourname.github.io
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
